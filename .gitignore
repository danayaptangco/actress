# Ignore CSV, TXT, and GIF files in outputs/
outputs/*.csv
outputs/*.txt
outputs/**/*.csv
outputs/**/*.txt
outputs/*.gif
outputs/**/*.gif


# Ignore all txt, npy, and csv files globally
*.txt
*.npy
*.csv
*.gif
*.pyc
*.egg
# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
